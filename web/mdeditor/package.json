{
  "name": "mdeditor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:seditor && tsc -b && vite build",
    "build:seditor": "cd ../seditor && npm exec -- esbuild src/index.js --bundle --format=iife --global-name=SEditor --outfile=../mdeditor/public/seditor.js --target=es2018",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
